# Server-side settings for the platform app. Copy to .env (git-ignored) and adjust.
# Loaded in development by vite.config.ts; variables set in the shell win.
# In production, set them in the environment (react-router-serve reads no .env file).

# Base URL of the API: later the Gateway (P-02). The port is a placeholder until P-02 picks one.
API_BASE_URL=http://localhost:5100

# on = answer requests to API_BASE_URL with MSW mocks (development only, D-33).
API_MOCKS=on

# normal | slow | error (500) | unauthorized (401)
API_MOCK_SCENARIO=normal
