{
  "name": "wibeblock",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "pnpm -r --parallel dev",
    "dev:studio": "pnpm --filter @wibeblock/studio-app dev",
    "dev:platform": "pnpm --filter @wibeblock/platform-app dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
